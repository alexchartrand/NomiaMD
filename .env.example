# Copy to `.env` at the repo root. Used by local dev and by docker compose (see DEPLOY.md).

# ============================================================================================
# Shared
# ============================================================================================

# --- Chat model: note extraction and the RAMQ chatbot ---
# API key of the chat model's provider. Required.
LLM_API_KEY=
# `mistral` (default) or `openai_compatible` (any OpenAI-compatible server, e.g. vLLM).
#LLM_PROVIDER=mistral
# Required for openai_compatible: base URL including /v1. Optional for mistral.
#LLM_ENDPOINT=http://localhost:8080/v1

# --- Embedding model: RAMQ code and manual search ---
# API key of the embedding model's provider. Required for mistral. With Mistral for both
# chat and embeddings, it's the same key as LLM_API_KEY.
EMBEDDING_API_KEY=
# Must be the model the RAMQ LanceDB tables were embedded with (ramq-ingestion).
EMBEDDING_MODEL="mistral-embed"
# `mistral` (default) or `openai_compatible` (any server exposing /v1/embeddings, e.g. TEI).
#EMBEDDING_PROVIDER=mistral
# Required for openai_compatible: base URL including /v1.
#EMBEDDING_ENDPOINT=http://localhost:8081/v1

# --- RAMQ data ---
# Path to the LanceDB directory produced by ramq-ingestion. Required. On the server, the
# directory scripts/deploy_db.sh syncs to (see DEPLOY.md).
DB_PATH=

# --- Login sessions ---
# Signs the session tokens. Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Session length in seconds. Defaults to 12 hours.
#JWT_EXPIRY_SECONDS=43200
# Session length in seconds when "Rester connecté" is checked. Defaults to 30 days.
#JWT_REMEMBER_ME_EXPIRY_SECONDS=2592000

# --- Background extraction ---
# Number of extractions a worker runs at once. Defaults to 4.
#WORKER_MAX_JOBS=4

# --- Logging ---
# DEBUG, INFO (default), WARNING or ERROR.
#LOG_LEVEL=INFO
# Shows detailed error pages. Keep false outside local dev.
DEBUG=false

# --- Contact form emails ---
# Each contact-form request is emailed to CONTACT_NOTIFY_EMAIL through this SMTP server.
# Unset = requests are only saved, not emailed. Port 465 = implicit TLS, others = STARTTLS.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
# Sender address. Defaults to SMTP_USERNAME.
#SMTP_FROM=
#CONTACT_NOTIFY_EMAIL=contact@nomiamd.com

# --- Epic sandbox demo ---
# Imports fhir.epic.com's synthetic notes into the inbox. Local dev and the demo stack only:
# refused when APP_ENV=production. Setup: docs/intake-step-11b-epic-sandbox-demo.md.
#EPIC_SANDBOX_ENABLED=false
# The fhir.epic.com app's non-production client ID.
#EPIC_SANDBOX_CLIENT_ID=
# Path to the private key. On the demo stack, an absolute path to a file readable by
# uid 10001.
#EPIC_SANDBOX_PRIVATE_KEY_PATH=~/.config/nomiamd/epic-sandbox/privatekey.pem
#EPIC_SANDBOX_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
#EPIC_SANDBOX_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# ============================================================================================
# Local dev only (docker compose overrides these: prod always runs as production, the demo
# stack as development)
# ============================================================================================

# Database URL. Defaults to a local SQLite file, e.g. for Postgres:
#   postgresql+psycopg://user:password@localhost:5432/nomiamd
DATABASE_URL=

# Redis URL. Set it to queue extractions for a separate worker; unset = extractions run
# inside the request.
#REDIS_URL=redis://localhost:6379/0

# Must be false when serving over plain HTTP (no TLS). Defaults to true.
COOKIE_SECURE=false

# Password of the admin account scripts/seed_db.py creates. Unset = it prompts for one.
#SEED_ADMIN_PASSWORD=

# `production` (default) or `development`. Development unlocks demo-only features (the Epic
# sandbox).
APP_ENV=development

# ============================================================================================
# Docker compose only
# ============================================================================================

# Password of the Postgres database. Required.
POSTGRES_PASSWORD=

# Comma-separated IPs/CIDRs allowed to reach the app and its API, e.g.
# 203.0.113.4/32,198.51.100.0/24. The public site stays open to everyone. Empty = nobody can
# reach the app.
ALLOWED_CIDRS=

# Demo stack only (see DEPLOY.md):
#COMPOSE_PROJECT_NAME=nomiamd-demo
#COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
# First three octets of the stack's private network. Defaults to 172.28.0 (prod).
#NETWORK_PREFIX=172.28.1
# Name Caddy reaches the stack's frontend by. Defaults to prod-frontend.
#EDGE_ALIAS=demo-frontend
