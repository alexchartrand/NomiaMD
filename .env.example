# Copy to .env and fill in, then `docker compose up --build`.
#
# NOTE on hosting: TLS is terminated by the `caddy` service (see Caddyfile at repo root),
# which is the only service publishing ports (80/443) — `frontend` is internal-only,
# reached solely via the Docker network. The Caddyfile's site addresses are hardcoded to
# nomiamd.com / www.nomiamd.com; update it if deploying under a different domain.

# --- Postgres ---
POSTGRES_PASSWORD=

# --- Mistral (real API calls — /extract and /query cost real money per request) ---
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL="mistral-embed"

# --- RAMQ LanceDB data ---
# Host path to the LanceDB directory produced by the separate ramq-ingestion repo
# (must already contain the `code-embeddings` and `codes` tables — the backend reads this
# at import time, so it won't even start, not just /extract, if this is empty or wrong).
# How this gets refreshed in a real staging/prod environment isn't solved by this compose
# file — it's a bind mount here for local/staging parity only.
RAMQ_LANCEDB_PATH=

# Host path to the separate LanceDB database (also produced by ramq-ingestion) backing
# ramq_chatbot's `documents-embeddings` table — distinct from RAMQ_LANCEDB_PATH above.
# Same import-time/startup caveat applies (this time for /query).
RAMQ_CHATBOT_LANCEDB_PATH=

# --- Network-level access restriction (nginx allowlist, see frontend/nginx.conf) ---
# Comma-separated IPs/CIDRs allowed to reach the app at all (both the UI and /api/*) —
# a defense-in-depth layer in front of the app's own per-user login. e.g.:
# ALLOWED_CIDRS=203.0.113.4/32,198.51.100.0/24
ALLOWED_CIDRS=

# --- Login sessions ---
# Signs the login session JWT. Required, no fallback — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# With `caddy` terminating TLS (see note above), the app is served over HTTPS, so this
# should be true in any real deploy — a `Secure` cookie is only silently dropped by the
# browser if serving plain HTTP, which is no longer the case here. Only set to false for a
# local/staging setup running without Caddy in front.
COOKIE_SECURE=true

# --- Logging ---
# Level for the backend's application log (JSON lines to stdout, see
# backend/app/logging_config.py). Defaults to INFO.
#LOG_LEVEL=INFO
