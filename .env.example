# The one environment file for both setups. Copy to `.env` at the repo root and fill in:
#   - Local dev (`make dev`, uvicorn, the backend scripts): backend/app/config.py loads it on
#     import; variables already exported in your shell take precedence.
#   - Deploy (`docker compose up --build`): compose reads it for its ${...} placeholders and
#     hands it to `backend` and `worker` as their env_file. Their `environment:` blocks in
#     docker-compose.yml override the values that must differ inside a container
#     (DATABASE_URL, REDIS_URL, DB_PATH, APP_ENV, COOKIE_SECURE).
#
# Three sections: shared, local dev only, docker compose only.
#
# Only use with synthetic patient data (see README's "Before using real patient data"
# section, Law 25): the LLM and embedding calls below are real, non-local calls, and query
# embeddings embed transcript-derived text, so they carry PHI like chat calls do.

# ============================================================================================
# Shared
# ============================================================================================

# --- Mistral (real API calls: /extract and /query cost real money per request) ---
# Used for structured extraction (app/extraction/engine.py; the chat model is set per task,
# see ExtractionTask.model in app/tasks/base.py), the ramq_chatbot, and retrieval embeddings
# when EMBEDDING_PROVIDER=mistral (app/llm/embeddings.py). MISTRAL_EMBEDDING_MODEL must be the
# model ramq-ingestion embedded the LanceDB tables with. There's no fallback/degraded mode:
# an unset key makes them raise at first use.
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL="mistral-embed"

# --- Chat model backend (app/llm/) ---
# `mistral` (default, uses MISTRAL_API_KEY) or `openai_compatible` (vLLM/TGI or any OpenAI
# chat-completions server; needs LLM_ENDPOINT and LLM_API_KEY). An unknown value fails at
# startup. LLM_ENDPOINT: for openai_compatible, the base URL *including* /v1; for mistral, an
# optional server-root override (no /v1). To develop without spending real chat-completion
# calls, point it at scripts/fake_llm_server.py (see `make dev-fake`); embeddings follow
# EMBEDDING_PROVIDER.
#LLM_PROVIDER=mistral
#LLM_ENDPOINT=http://localhost:8080/v1
#LLM_API_KEY=

# --- Query-embedding backend (app/llm/embeddings.py) ---
# `mistral` (default, MISTRAL_API_KEY + MISTRAL_EMBEDDING_MODEL) or `openai_compatible`
# (TEI/vLLM or any server exposing /v1/embeddings; needs EMBEDDING_ENDPOINT, base URL
# *including* /v1, and EMBEDDING_MODEL). At startup the backend embeds a probe string and
# refuses to start if its dimension doesn't match the vector columns of the current codes
# table and documents-embeddings; switching models means re-embedding those tables in
# ramq-ingestion first. EMBEDDING_API_KEY is optional: TEI/vLLM run without auth by default.
#EMBEDDING_PROVIDER=mistral
#EMBEDDING_ENDPOINT=http://localhost:8081/v1
#EMBEDDING_MODEL=
#EMBEDDING_API_KEY=

# --- RAMQ LanceDB data (required) ---
# Host path to the LanceDB directory produced by the separate ramq-ingestion repo: the
# versioned `codes_<rev>` tables + `code_versions` registry (billing_codes) and the
# `documents-embeddings` table (ramq_chatbot). The backend refuses to start if no code
# version is current. Locally the backend reads it directly; compose bind-mounts it read-only
# into the containers. On the server it's pushed with ramq-ingestion's scripts/deploy_db.sh,
# which syncs into <remote base>/<basename of its DB_PATH>: point this at that
# subdirectory (see DEPLOY.md).
DB_PATH=

# --- Login sessions ---
# Signs the login session JWT. Required, no fallback. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# How long a login session lasts before re-login is required. Defaults to 12h (one shift).
#JWT_EXPIRY_SECONDS=43200
# How long a login session lasts when "Stay connected" is checked. Defaults to 30 days.
#JWT_REMEMBER_ME_EXPIRY_SECONDS=2592000

# --- Background extraction (app/worker.py) ---
# Concurrent extractions per worker process. Size it to the LLM endpoint's throughput.
#WORKER_MAX_JOBS=4

# --- Logging and debug ---
# Level for the application log (JSON lines to stdout, see app/logging_config.py).
#LOG_LEVEL=INFO
# FastAPI debug mode (detailed error pages). Keep false in prod. For verbose retrieval/LLM
# logging, use LOG_LEVEL=DEBUG instead.
DEBUG=false

# --- Contact-form notifications (POST /contact, app/contact/notifier.py) ---
# Every request is saved in `contact_requests` regardless. With SMTP_HOST and
# CONTACT_NOTIFY_EMAIL set, each one is also emailed there (port 465 = implicit TLS, anything
# else = STARTTLS). Unset = the notification is only logged. SMTP_FROM defaults to
# SMTP_USERNAME.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=
#CONTACT_NOTIFY_EMAIL=contact@nomiamd.com

# --- Epic sandbox demo (docs/intake-step-11b-epic-sandbox-demo.md) ---
# Pulls the signed notes of fhir.epic.com's synthetic patients into the inbox (Ajouter
# manuellement → "Epic — démo"). Off by default. Refused under APP_ENV=production, so it runs
# locally or on the demo stack only, never prod. On the demo stack, docker-compose.demo.yml
# mounts the key at EPIC_SANDBOX_PRIVATE_KEY_PATH (use an absolute path there) into the
# containers, which run as uid 10001: `sudo chown 10001 <key> && sudo chmod 400 <key>`.
# Backend services auth: the client id is the fhir.epic.com app's non-production one. Epic
# reads the public key from the app's "Non-Production JWK Set URL",
# https://nomiamd.com/.well-known/jwks.json (app/jwks/): commit the key's public half under
# backend/app/jwks/public_keys/ and deploy. The assertion's `kid` is derived from the key.
# Keep the private key outside the repo, e.g. (from backend/):
#   openssl genrsa -out ~/.config/nomiamd/epic-sandbox/privatekey.pem 2048
#   openssl pkey -in ~/.config/nomiamd/epic-sandbox/privatekey.pem -pubout -out app/jwks/public_keys/epic-sandbox.pem
# Which patients are imported: app/intake/connectors/epic_fhir/sandbox_patients.json,
# written by scripts/epic_sandbox_inventory.py --write (then re-run scripts/seed_db.py).
#EPIC_SANDBOX_ENABLED=false
#EPIC_SANDBOX_CLIENT_ID=
#EPIC_SANDBOX_PRIVATE_KEY_PATH=~/.config/nomiamd/epic-sandbox/privatekey.pem
#EPIC_SANDBOX_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
#EPIC_SANDBOX_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# ============================================================================================
# Local dev only (compose sets its own values for these in docker-compose.yml)
# ============================================================================================

# Defaults to a local SQLite file (backend/nomiamd.db) if unset. Compose always uses its
# `postgres` service. To try Postgres locally, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nomiamd
DATABASE_URL=

# The default "memory://" keeps extraction inline, with no worker needed. With a real Redis
# (`make redis`), received notes are queued for `make worker` (arq) instead of being
# extracted inside the request. Compose always uses its `redis` service.
#REDIS_URL=redis://localhost:6379/0

# Whether the session cookie gets the `Secure` flag (HTTPS-only). Defaults to true.
# Browsers silently drop `Secure` cookies over plain HTTP, so it must be false when running
# uvicorn directly (no TLS). Compose forces true, since `caddy` terminates TLS there.
COOKIE_SECURE=false

# Password for the admin account scripts/seed_db.py creates. Unset = it prompts for one.
#SEED_ADMIN_PASSWORD=

# development (default) or production. Demo-only features check it: the Epic sandbox flag
# above refuses to start when APP_ENV=production. Compose sets production, and
# docker-compose.demo.yml development.
#APP_ENV=development

# ============================================================================================
# Docker compose only
# ============================================================================================
# Hosting: one host runs up to two app stacks, prod (a release tag) and demo (a branch), each
# from its own checkout with its own .env, as separate compose projects. Neither publishes
# a port: TLS is terminated by the shared `caddy` in edge/docker-compose.yml (its own
# project, the only one on 80/443), whose edge/Caddyfile maps nomiamd.com and
# demo.nomiamd.com to each stack's frontend. See DEPLOY.md.

# Compose project name; also prefixes the stack's volumes, so never change it on a running
# stack (prod's is its checkout directory's name, `nomiamd`, when unset). Set it on demo:
#COMPOSE_PROJECT_NAME=nomiamd-demo

# Demo stack only: adds docker-compose.demo.yml (APP_ENV=development, the Epic key mount).
#COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml

# The first three octets of this stack's private /24 network: Docker refuses two stacks
# with overlapping subnets. Defaults to 172.28.0 (prod); set e.g. 172.28.1 on demo.
#NETWORK_PREFIX=172.28.0

# The name edge/Caddyfile reaches this stack's frontend by: prod-frontend (default) or
# demo-frontend.
#EDGE_ALIAS=prod-frontend

# Password of the `postgres` service's `nomiamd` user (compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=

# Network-level access restriction (nginx allowlist, see frontend/nginx.conf).
# Comma-separated IPs/CIDRs allowed to reach the app (/app, /login and /api/*): a
# defense-in-depth layer in front of the app's own per-user login. The public site (/,
# /prix, /contact, /securite, /confidentialite, static assets) and the contact form's
# /api/contact stay open to everyone. Empty = nobody can reach the app, only the public
# site. e.g.:
# ALLOWED_CIDRS=203.0.113.4/32,198.51.100.0/24
ALLOWED_CIDRS=
