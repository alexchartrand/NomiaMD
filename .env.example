# Copy to .env and fill in, then `docker compose up --build`.
#
# NOTE on hosting: this compose file is portable local/staging setup — it has no TLS and
# publishes the frontend on a plain HTTP port. A real deploy needs a TLS-terminating
# reverse proxy in front of `frontend` (Caddy/Traefik/cloud load balancer), added
# separately once a hosting target is chosen; not part of this file.

# --- Postgres ---
POSTGRES_PASSWORD=

# --- Mistral (real API calls — /extract and /query cost real money per request) ---
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL="mistral-embed"

# --- RAMQ LanceDB data ---
# Host path to the LanceDB directory produced by the separate ramq-ingestion repo
# (must already contain the `code-embeddings`, `codes`, and `manuel-omnipraticiens`
# tables — the backend reads this at import time, so it won't even start, not just
# /extract or /query, if this is empty or wrong). How this gets refreshed in a real
# staging/prod environment isn't solved by this compose file — it's a bind mount here
# for local/staging parity only.
RAMQ_LANCEDB_PATH=

# --- Network-level access restriction (nginx allowlist, see frontend/nginx.conf) ---
# Comma-separated IPs/CIDRs allowed to reach the app at all (both the UI and /api/*) —
# a defense-in-depth layer in front of the app's own per-user login. e.g.:
# ALLOWED_CIDRS=203.0.113.4/32,198.51.100.0/24
ALLOWED_CIDRS=

# --- Login sessions ---
# Signs the login session JWT. Required, no fallback — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# See the TLS note above: this compose file has no TLS, so a `Secure` session cookie would
# be silently dropped by the browser. Keep this false until a TLS-terminating reverse proxy
# is in front of `frontend`, then flip it to true.
COOKIE_SECURE=false
