# Copy to .env and fill in. python-dotenv loads this automatically if you add
# `from dotenv import load_dotenv; load_dotenv()` at the top of app/main.py, or export
# these in your shell before running uvicorn.

# Only use with synthetic patient data (see README's "Before using real patient data"
# section, Law 25) — this is a real, non-local model call.
#
# Used for both structured extraction (app/extraction/engine.py, model name hardcoded
# there as MODEL) and candidate retrieval embeddings (app/ramq_codes/retriever.py via
# app/embedings.py, model name in MISTRAL_EMBEDDING_MODEL below). There's no
# fallback/degraded mode: an unset key makes both raise at first use. To develop against
# extraction without spending real API calls, point MISTRAL_ENDPOINT at
# scripts/fake_llm_server.py instead (see `make dev-fake`).
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL="mistral-embed"
#MISTRAL_ENDPOINT=http://localhost:8080

# Directory of the LanceDB database RAMQ data is read from (tables `codes` and
# `manuel-omnipraticiens`) — produced by the separate `ramq-ingestion` repo, see its README.
DB_PATH=

# Defaults to a local SQLite file if unset. Point this at Postgres for anything beyond
# local development, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nomiamd
DATABASE_URL=

# Enables verbose retrieval logging (e.g. RAMQManualRetriever's QueryFusionRetriever
# logging its generated sub-queries). Unset/false in prod; set to true for local dev.
DEBUG=false

# Signs the login session JWT. Required, no fallback — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# How long a login session lasts before re-login is required. Defaults to 12h (one shift).
#JWT_EXPIRY_SECONDS=43200

# Whether the session cookie gets the `Secure` flag (HTTPS-only). Defaults to true;
# browsers silently drop `Secure` cookies over plain HTTP, so this must be set to false when
# running uvicorn directly for local dev (no TLS). docker-compose now terminates TLS via the
# `caddy` service (see root .env.example) and defaults COOKIE_SECURE=true there.
COOKIE_SECURE=false
