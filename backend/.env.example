# Copy to .env and fill in. app/config.py loads it automatically on import (and the
# scripts load it themselves); variables already exported in your shell take precedence.

# Only use with synthetic patient data (see README's "Before using real patient data"
# section, Law 25) — this is a real, non-local model call.
#
# Used for structured extraction (app/extraction/engine.py; the chat model is set per task,
# see ExtractionTask.model in app/tasks/base.py), the ramq_chatbot, and retrieval embeddings
# when EMBEDDING_PROVIDER=mistral (app/llm/embeddings.py, model name in
# MISTRAL_EMBEDDING_MODEL below — must be the model ramq-ingestion embedded the LanceDB
# tables with). There's no fallback/degraded mode: an unset key makes them raise at first
# use.
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL="mistral-embed"

# Chat model backend (app/llm/): `mistral` (default, uses MISTRAL_API_KEY) or
# `openai_compatible` (vLLM/TGI or any OpenAI chat-completions server; needs LLM_ENDPOINT
# and LLM_API_KEY). An unknown value fails at startup.
#LLM_PROVIDER=mistral
# For openai_compatible: the base URL *including* /v1. For mistral: optional server-root
# override (no /v1). To develop without spending real chat-completion calls, point it at
# scripts/fake_llm_server.py (see `make dev-fake`) — embeddings follow EMBEDDING_PROVIDER.
#LLM_ENDPOINT=http://localhost:8080/v1
#LLM_API_KEY=

# Query-embedding backend (app/llm/embeddings.py): `mistral` (default, MISTRAL_API_KEY +
# MISTRAL_EMBEDDING_MODEL) or `openai_compatible` (TEI/vLLM or any server exposing
# /v1/embeddings; needs EMBEDDING_ENDPOINT, base URL *including* /v1, and EMBEDDING_MODEL).
# Query embeddings embed transcript-derived text, so they carry PHI like chat calls do.
# At startup the backend embeds a probe string and refuses to start if its dimension
# doesn't match the vector columns of the current codes table and documents-embeddings —
# switching models means re-embedding those tables in ramq-ingestion first.
#EMBEDDING_PROVIDER=mistral
#EMBEDDING_ENDPOINT=http://localhost:8081/v1
#EMBEDDING_MODEL=
# Optional; TEI/vLLM run without auth by default.
#EMBEDDING_API_KEY=

# Directory of the LanceDB database RAMQ data is read from (required) — versioned
# `codes_<rev>` tables plus the `code_versions` registry, used by billing_codes, and
# `documents-embeddings`, used by ramq_chatbot. Produced by the separate `ramq-ingestion`
# repo, see its README. The backend refuses to start if no code version is current.
DB_PATH=

# Defaults to a local SQLite file if unset. Point this at Postgres for anything beyond
# local development, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nomiamd
DATABASE_URL=

# FastAPI debug mode (detailed error pages). Unset/false in prod. For verbose retrieval/LLM
# logging use LOG_LEVEL=DEBUG instead.
DEBUG=false

# Signs the login session JWT. Required, no fallback — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# How long a login session lasts before re-login is required. Defaults to 12h (one shift).
#JWT_EXPIRY_SECONDS=43200

# How long a login session lasts when "Stay connected" is checked at login. Defaults to
# 30 days.
#JWT_REMEMBER_ME_EXPIRY_SECONDS=2592000

# Whether the session cookie gets the `Secure` flag (HTTPS-only). Defaults to true;
# browsers silently drop `Secure` cookies over plain HTTP, so this must be set to false when
# running uvicorn directly for local dev (no TLS). docker-compose now terminates TLS via the
# `caddy` service (see root .env.example) and defaults COOKIE_SECURE=true there.
COOKIE_SECURE=false

# Level for the application log (JSON lines to stdout, see app/logging_config.py).
# Defaults to INFO.
#LOG_LEVEL=INFO

# Contact-form notifications (POST /contact, app/contact/notifier.py). Every request is
# saved in `contact_requests` regardless; with SMTP_HOST and CONTACT_NOTIFY_EMAIL set, each
# one is also emailed there (port 465 = implicit TLS, anything else = STARTTLS). Unset =
# the notification is only logged.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
# Sender address; defaults to SMTP_USERNAME.
#SMTP_FROM=
#CONTACT_NOTIFY_EMAIL=contact@nomiamd.com

# development (default) or production. Demo-only features check it: the Epic sandbox flag
# below refuses to start when APP_ENV=production.
#APP_ENV=development

# Epic sandbox demo (docs/intake-step-11b-epic-sandbox-demo.md): pulls the signed notes of
# fhir.epic.com's synthetic patients into the inbox (Ajouter manuellement → "Epic — démo").
# Off by default. Backend services auth: the client id is the fhir.epic.com app's
# non-production one. Epic reads the public key from the app's "Non-Production JWK Set URL":
# a public HTTPS URL serving `uv run python scripts/epic_sandbox_jwks.py`'s output, which
# also prints the EPIC_SANDBOX_KEY_ID to set. Keep the private key outside the repo, e.g.:
#   openssl genrsa -out ~/.config/nomiamd/epic-sandbox/privatekey.pem 2048
# Which patients are imported: app/intake/connectors/epic_fhir/sandbox_patients.json,
# written by scripts/epic_sandbox_inventory.py --write (then re-run scripts/seed_db.py).
#EPIC_SANDBOX_ENABLED=false
#EPIC_SANDBOX_CLIENT_ID=
#EPIC_SANDBOX_PRIVATE_KEY_PATH=~/.config/nomiamd/epic-sandbox/privatekey.pem
# The key's `kid` in the JWK Set (required with a JWK Set URL).
#EPIC_SANDBOX_KEY_ID=
#EPIC_SANDBOX_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
#EPIC_SANDBOX_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
