# Copy to deploy/deploy.local.env (gitignored) and fill in. deploy/deploy.sh reads it; the same
# variables set in the environment win over it.

# The server, as you'd pass it to ssh (user@host, or a Host alias from ~/.ssh/config).
DEPLOY_SSH=user@nomiamd.com

# The stacks' checkouts on the server. Defaults below.
#PROD_DIR=/opt/nomiamd/NomiaMD
#DEMO_DIR=/opt/nomiamd/NomiaMD-demo
