# The demo stack's values on top of the root .env.example (demo.nomiamd.com: a branch,
# synthetic and Epic-sandbox data only). deploy/init-env.sh demo writes a .env from both (plus
# generated JWT_SECRET_KEY, POSTGRES_PASSWORD and SEED_ADMIN_PASSWORD); deploy/check-env.sh
# checks that every uncommented key below is in the server's .env. Blank values are yours to
# fill.

# Its own compose project, network and edge alias, so it never collides with prod's.
COMPOSE_PROJECT_NAME=nomiamd-demo
COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
NETWORK_PREFIX=172.28.1
EDGE_ALIAS=demo-frontend

# docker-compose.demo.yml pins it; development is what lets the Epic sandbox run.
APP_ENV=development
COOKIE_SECURE=true
DEBUG=false

# Shared with prod: the same LanceDB directory, mounted read-only (see DEPLOY.md step 2).
DB_PATH=

# Empty = nobody can reach the app.
ALLOWED_CIDRS=

# The Epic sandbox demo (docs/intake-step-11b-epic-sandbox-demo.md). The key file must be
# readable by the containers' user (uid 10001), see DEPLOY.md.
EPIC_SANDBOX_ENABLED=true
EPIC_SANDBOX_CLIENT_ID=
EPIC_SANDBOX_PRIVATE_KEY_PATH=/opt/nomiamd/secrets/epic-sandbox.pem

# SEED_ADMIN_PASSWORD (generated by init-env.sh): the seeded admin's password, so
# `deploy.sh demo --reset-data` reseeds without a prompt.
