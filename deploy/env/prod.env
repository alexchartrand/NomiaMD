# The prod stack's values on top of the root .env.example. deploy/init-env.sh prod writes a
# .env from both (plus generated JWT_SECRET_KEY and POSTGRES_PASSWORD); deploy/check-env.sh
# checks that every uncommented key below is in the server's .env. Blank values are yours to
# fill.

# docker-compose.yml pins these inside the containers anyway; set here so the .env says what
# actually runs.
APP_ENV=production
COOKIE_SECURE=true
DEBUG=false

# The subdirectory ramq-ingestion's scripts/deploy_db.sh syncs to, e.g.
# /opt/nomiamd/data/ramq-lancedb (not /opt/nomiamd/data itself, see DEPLOY.md step 2).
DB_PATH=

# The clinic's and your own addresses. Empty = nobody can reach the app.
ALLOWED_CIDRS=

# Optional, see .env.example: the contact form's SMTP_* and CONTACT_NOTIFY_EMAIL (unset =
# requests are only saved, not emailed), LLM_PRICES, APP_VERSION (deploy/deploy.sh sets it).
